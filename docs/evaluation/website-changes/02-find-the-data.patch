diff --git a/website/src/components/ui/modality-cards.tsx b/website/src/components/ui/modality-cards.tsx
new file mode 100644
index 0000000..ecf0554
--- /dev/null
+++ b/website/src/components/ui/modality-cards.tsx
@@ -0,0 +1,42 @@
+import Link from "next/link";
+import { ArrowRight } from "lucide-react";
+import { MODALITIES } from "@/lib/modalities";
+
+/** Every modality's data page at a glance, one card each, links always visible. */
+export function ModalityCards() {
+  return (
+    <div id="data" className="mx-auto w-full max-w-7xl scroll-mt-24 px-4 pb-16 md:px-8 lg:px-12">
+      <h3 className="text-lg font-semibold tracking-tight">Explore the sample data</h3>
+      <p className="mt-1 max-w-xl text-sm text-muted-foreground">
+        Each page shows one sample recording, with a plain-language guide to what it shows.
+      </p>
+      <ul className="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
+        {MODALITIES.map((m) => (
+          <li key={m.key} className="flex flex-col gap-3 rounded-2xl border border-border bg-card p-5">
+            <div className="flex items-baseline justify-between gap-2">
+              <h4 className="text-xl font-medium tracking-tight">{m.title}</h4>
+              <span className="text-xs tabular-nums text-muted-foreground">/{m.id}</span>
+            </div>
+            <p className="text-sm leading-snug">{m.measures}</p>
+            <p className="text-sm leading-snug text-muted-foreground">{m.sample}</p>
+            <div className="mt-auto pt-2">
+              {m.href ? (
+                <Link
+                  href={m.href}
+                  className="inline-flex items-center gap-1.5 rounded-full bg-foreground px-4 py-2 text-sm font-medium text-background transition-opacity hover:opacity-85"
+                >
+                  Explore the data
+                  <ArrowRight className="h-3.5 w-3.5" aria-hidden="true" />
+                </Link>
+              ) : (
+                <span className="inline-flex rounded-full border border-dashed border-border px-4 py-2 text-sm text-muted-foreground">
+                  Coming soon
+                </span>
+              )}
+            </div>
+          </li>
+        ))}
+      </ul>
+    </div>
+  );
+}
