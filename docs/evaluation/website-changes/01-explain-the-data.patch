+/** "The camera read 75 bpm; the fingertip sensor read 72 — within 0.2 bpm on average." */
+function rppgTakeaway(session: RppgSession, refHr?: number) {
+  const hr = session.vitals.hr_bpm;
+  if (hr === undefined) return undefined;
+  const mae = session.scores.pos.maeBpm;
+  if (refHr === undefined || mae === undefined) {
+    return (
+      <>
+        Without touching the skin, the camera measured a heart rate of <strong>{Math.round(hr)} bpm</strong>.
+      </>
+    );
+  }
+  // second-by-second averages on both sides, so the two numbers are comparable
+  const camHr = mean(session.track.pos) ?? hr;
+  return (
+    <>
+      Without touching the skin, the camera’s heart rate stayed within <strong>{mae.toFixed(1)} bpm</strong> of a
+      fingertip sensor on average ({camHr.toFixed(1)} vs {refHr.toFixed(1)} bpm).
+    </>
+  );
+}
