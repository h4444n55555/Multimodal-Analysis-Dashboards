+// Plain-language copy for the data pages: what each recording is, what each
+// widget shows, and what the jargon means. Kept in one file so it can be
+// reviewed and edited without touching the dashboards.
+
+export type ModalityKey = "thermal" | "ecg" | "rppg";
+
+export type About = {
+  /** one sentence: what was recorded */
+  recorded: string;
+  /** why this recording is shown */
+  source: string;
+  /** what a first-time visitor should notice */
+  lookFor: string[];
+};
+
+export const HOW_TO_READ =
+  "Each box is one view of the same recording. Hover a chart to read values, click the overview to move the close-up, and drag a box by its title to rearrange.";
+
+export const ABOUT: Record<ModalityKey, About> = {
+  thermal: {
+    recorded:
+      "A 12-second thermal-camera video of a person drinking a cold glass of juice: every pixel is a skin or room temperature.",
+    source:
+      "A public-domain clip stands in until the study’s own thermal recordings are released. Its temperatures are rebuilt from the video’s colours, so treat the exact degrees as approximate.",
+    lookFor: [
+      "The mouth region cools while the cold drink touches the lips, then warms back up.",
+      "The face is clearly warmer than the room; the histogram shows these as two separate humps.",
+      "In the study, the same per-region tracking picks up stress: the nose tip cools and the skin around the eyes warms.",
+    ],
+  },
+  ecg: {
+    recorded:
+      "Five minutes of a driver’s heart activity (a chest ECG): the first part parked at rest, the rest driving through a city.",
+    source:
+      "A public research recording (MIT driver-stress study, via PhysioNet) stands in until the study’s own ECG recordings are released. Every number on this page comes from the study’s own analysis code.",
+    lookFor: [
+      "The heart beats faster once city driving starts: compare the heart-rate chart before and after the line.",
+      "The heartbeat also becomes more regular under stress: beat-to-beat variation roughly halves in the city.",
+      "Skin conductance (light sweating) and shoulder muscle tension, recorded at the same time, jump at the same moment.",
+    ],
+  },
+  rppg: {
+    recorded:
+      "A pulse measured with no contact at all: an ordinary camera tracks tiny colour changes in the face as blood pumps through the skin.",
+    source:
+      "This sample is simulated, with a known pulse, so the page can show the method before the study’s own camera recordings are released. The analysis is the study’s real rPPG code; a fingertip pulse sensor serves as the reference.",
+    lookFor: [
+      "The camera’s heart rate closely follows the fingertip sensor’s, even though nothing touches the skin.",
+      "When the head moves, the signal quality drops and the page says so instead of guessing.",
+      "Breathing rate is read from the same pulse signal, with no chest sensor.",
+    ],
+  },
+};
+
+/** One line under each widget, saying what it shows in everyday words. */
+export const CAPTIONS: Record<ModalityKey, Record<string, string>> = {
+  thermal: {
+    video: "The camera’s view: brighter colours are warmer. The boxes mark the face regions tracked below.",
+    now: "The average temperature inside each box at this moment of the video.",
+    hist: "How many pixels sit at each temperature. The left hump is the room, the right one the face.",
+    series: "How each face region’s temperature changes through the video. Switch to “Change” to compare them.",
+    ranges: "The coolest-to-warmest span of each region over the whole video; the dot is its average.",
+    frame: "Quick numbers for the frame on screen: the hottest pixel, the face’s average and how much of the view is face.",
+    facts: "The camera and the clip this page is built from.",
+  },
+  ecg: {
+    trace: "The heart’s electrical signal as recorded (top) and after noise is removed (bottom). Each dot is one heartbeat.",
+    "hr-now": "Average beats per minute over the whole five minutes.",
+    hrv: "How much the time between beats varies. More variation usually means a more relaxed body.",
+    overview: "The whole five minutes at a glance. The coloured strip shows how clean the signal is in each 5-second stretch.",
+    drive: "The entire 84-minute drive this excerpt comes from, with rest, city and highway sections.",
+    hr: "Heart rate beat by beat. Watch it climb after city driving starts.",
+    resp: "Chest movement from a breathing belt worn at the same time; each wave is one breath.",
+    skin: "Skin conductance rises when we sweat slightly, a classic sign of stress or alertness.",
+    quality: "Whether the recording is clean enough to trust, and how many beats were left out.",
+    beat: "Every heartbeat laid on top of each other and averaged: the classic heartbeat shape.",
+    poincare: "Each dot is one gap between beats plotted against the next. A tighter cloud means a steadier rhythm.",
+    spectrum: "Which slow rhythms drive the changes in heart rate: breathing shows up on the right (HF), stress-linked rhythms on the left (LF).",
+    facts: "Where this recording comes from and what else was measured with it.",
+    emg: "Shoulder muscle tension recorded at the same time; it tends to rise with stress.",
+  },
+  rppg: {
+    pulse: "Top: the face’s average green colour, barely changing. Bottom: the pulse extracted from it, with the fingertip sensor dashed.",
+    "hr-now": "Heart rate measured by the camera alone, with the fingertip sensor’s value for comparison.",
+    breathing: "Breaths per minute, read from small rhythmic changes in the pulse signal.",
+    overview: "The whole recording at a glance. The strip shows how trustworthy each 5-second stretch is.",
+    hr: "The camera’s heart rate (solid) against the fingertip sensor (dashed), updated every second.",
+    methods: "Three standard recipes for turning face colour into a pulse, scored against the fingertip sensor.",
+    quality: "How strongly the pulse stands out from noise. Below the floor, the page shows nothing rather than a guess.",
+    hrv: "How much the time between beats varies, after unreliable beats are left out.",
+    rgb: "The raw face colour in red, green and blue. The pulse is a tiny ripple; head movement causes the big swings.",
+    channels: "How strongly each colour pulses. Blood absorbs green light most, so green should be strongest.",
+    beat: "All pulses averaged into one shape, rising quickly and falling slowly.",
+    spectrum: "Which beat speeds are present in the signal. The tallest peak is the heart rate.",
+    withheld: "Measures a camera cannot give reliably without first checking against a real device.",
+    facts: "The camera, the length of the recording and the reference used.",
+  },
+};
+
+/** Short definitions shown on hover or keyboard focus. */
+export const TERMS: Record<string, string> = {
+  RMSSD: "Typical change in time from one heartbeat to the next, in milliseconds. Higher usually means more relaxed.",
